      },
      "configuration" : {
        "scriptLang" : "JS",
        "jsScript" : "var phoneNumber = metadata.ss_alertPhoneNumber.trim();\r\nvar sendCall = msg.alert_tier === \"high\";\r\nvar params = {\r\n    eventId: msg.alert_event_id,\r\n    phoneNumber: phoneNumber,\r\n    tier: msg.alert_tier,\r\n    device: msg.alert_device,\r\n    riskScore: msg.alert_risk_score,\r\n    message: msg.alert_message,\r\n    channels: sendCall ? [\"sms\", \"call\"] : [\"sms\"]\r\n};\r\nif (sendCall) {\r\n    params.callDurationSeconds = 20;\r\n}\r\nreturn {\r\n    msg: {\r\n        method: \"sendAlert\",\r\n        params: params\r\n    },\r\n    metadata: metadata,\r\n    msgType: \"RPC_CALL_FROM_SERVER_TO_DEVICE\"\r\n};",
