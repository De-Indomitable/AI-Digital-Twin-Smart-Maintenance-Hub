      "additionalInfo" : {
        "description" : "Derives alert_tier, alert_event_id, alert_message, alert_device and alert_risk_score from risk_score. Fields already present on the message are never overwritten, so a publisher that sends them itself still works. Edit HIGH_THRESHOLD and MEDIUM_THRESHOLD here.",
        "layoutX" : 700,
        "layoutY" : 535
      },
      "configuration" : {
        "scriptLang" : "JS",
        "jsScript" : "var HIGH_THRESHOLD = 75;\nvar MEDIUM_THRESHOLD = 40;\n\nvar score = msg.risk_score;\n\nif (typeof score !== \"number\") {\n    return {msg: msg, metadata: metadata, msgType: msgType};\n}\n\nvar device = msg.alert_device || metadata.shared_active_device || metadata.deviceName;\n\nvar labels = {\n    \"IP-001\": \"Infusion Pump\",\n    \"PM-001\": \"Patient Monitor\",\n    \"SM-001\": \"Suction Machine\",\n    \"OC-001\": \"Oxygen Concentrator\"\n};\nvar label = labels[device] || device;\n\nmetadata.alert_device = device;\n\nif (!msg.alert_tier) {\n    if (score >= HIGH_THRESHOLD) {\n        msg.alert_tier = \"high\";\n    } else if (score >= MEDIUM_THRESHOLD) {\n        msg.alert_tier = \"medium\";\n    }\n}\n\nif (msg.alert_tier === \"medium\" || msg.alert_tier === \"high\") {\n    msg.alert_device = device;\n    if (typeof msg.alert_risk_score !== \"number\") {\n        msg.alert_risk_score = score;\n    }\n    if (!msg.alert_event_id) {\n        msg.alert_event_id = \"\" + metadata.ts + \"-\" + device;\n    }\n    if (!msg.alert_message) {\n        msg.alert_message = \"Attention needed! Abnormal behaviour detected with the \" + label;\n    }\n    metadata.alert_tier = msg.alert_tier;\n}\n\nreturn {msg: msg, metadata: metadata, msgType: msgType};",
        "tbelScript" : ""
